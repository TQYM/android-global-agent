.server-snapshots/
*.tgz
.*.sh
.*.py

# Local uploads, disk images and editor tooling
.dsh-uploads/
*.sparsebundle/

# Non-repo staging: unrelated local/prototype files kept out of git
/_local/

# Local competition materials (kept on disk, not part of the repo)
/竞赛材料/

# Built daemon binary and per-device test result logs (regenerated)
agentd-go/build/
agent-client/assets/vd_daemon.jar
tests/results-*.jsonl

# 服务端编译产物（go build 现场生成）
agentlite-server/agentlite-server

.m3-deps/

# 可读性/文案门禁的生成物（classes 由 javac 现场编译）
tests/ui_text_test/classes/
tests/ui_widget_guard-cache/
tests/ui_text_test/javac.log

# 桌面 JVM 测试的编译产物（javac 现场生成，含 lan_peer_sim）
*.class

# Swift Package Manager 构建产物（ios/ 实测 .build 约数十 MB，必须排除）
.build/
ios/.build/

# iOS App 的本地联调证书与构建产物（由 scripts/prepare-resources.sh 现场生成）
ios/App/Resources/
ios/App/build/

# DSH 环境脚本与外部工具目录：属于 ~/.dsh 环境维护（项目 dsh-env），不是本 Android 仓库的产物
/apply.sh
/rollback.sh
/.workbuddy/
