# 整合层敏感配置模板
#
#   cp local.env.example local.env   →  填写真实值
#
# local.env 已被 agent-unified/.gitignore 忽略，**永不入 git**。
# 它只在构建期被 scripts/gen-client-env.sh 读走，注入客户端原生的 dev.local，
# 不写入任何一端源码，也不进 dist/ 发布件。

# 模型直连（不经额度网关时使用）
API_KEY=sk-在此填写
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen3.5-omni-plus

# 可选：覆盖 unified.conf 里的同步服务地址（留空则用 unified.conf 的 SYNC_URL）
# SYNC_URL=https://8.133.225.105:18443

# 可选：服务端额度网关的管理令牌（仅 deploy 时用，不进 APK）
# ADMIN_TOKEN=
