<!-- 适老化输入框：粗边框，聚焦时变蓝加粗 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/elder_card"/>
            <corners android:radius="14dp"/>
            <stroke android:width="3dp" android:color="@color/elder_primary"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/elder_card"/>
            <corners android:radius="14dp"/>
            <stroke android:width="2dp" android:color="@color/elder_border"/>
        </shape>
    </item>
</selector>
