<!-- 充值页（2026-09-15 改版）：跳 DeepSeek 官方充值页 → 控制台创建 API Key → 回本页粘贴并校验启用。
     旧的「下单 → 兑换码支付 → 订单记录」链路已按决策从本页移除（服务端代码保留）。
     支付必须由用户本人在官方页面完成，App 内不代收、也不替用户确认付款。

     适老化改版（手机形态，本页只从设置页进入）：
     - 浅色高对比 + 大字号（正文 20sp，按钮 24sp，按钮 ≥64dp）；
     - 仍按真实任务流分区：说明 → ① API Key → ② 单模型模式 → ③ 官方充值 → 状态，
       每一步标题前带序号，老人知道先做哪一步；
     - 全部 id 不变（含复用的 etCode / btnCancel / 被 Java 整体隐藏的 orderArea）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootPurchase"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elder_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/purchaseContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/elder_page_margin"
        android:paddingRight="@dimen/elder_page_margin"
        android:paddingTop="@dimen/elder_gap"
        android:paddingBottom="@dimen/elder_card_padding">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnBack"
                style="@style/Elder.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:drawableStart="@drawable/ic_elder_back"
                android:text="返回"/>
            <TextView
                style="@style/Elder.Text.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/elder_gap"
                android:text="额度充值"/>
        </LinearLayout>
        <TextView
            style="@style/Elder.Text.Note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap_s"
            android:text="充值与 Key 都在你自己的 DeepSeek 账号里，App 不代收费用"/>

        <TextView
            android:id="@+id/tvPayHint"
            style="@style/Elder.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap"
            android:background="@drawable/bg_elder_neutral"
            android:padding="@dimen/elder_gap"
            android:text="购买方式：在 DeepSeek 官方页面充值（按量计费），然后创建 API Key。"/>

        <!-- ① API Key：DeepSeek 控制台创建后粘贴到这里（官方无自动创建接口） -->
        <LinearLayout
            style="@style/Elder.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="@style/Elder.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="① 配置 API Key"/>
            <TextView
                android:id="@+id/tvAkLabel"
                style="@style/Elder.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DeepSeek API Key（仅存本机，Keystore 加密）"/>
            <EditText
                android:id="@+id/etAkId"
                style="@style/Elder.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="sk-…（在 DeepSeek 控制台创建）"
                android:singleLine="true"/>

            <!-- DeepSeek 只需一个 API Key 字段，AccessKeySecret 一栏不再需要（2026-09-15 充值改版） -->
            <TextView
                android:id="@+id/tvAkSecretLabel"
                style="@style/Elder.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AccessKeySecret"
                android:visibility="gone"/>

            <!-- 复用 id=etCode（源自兑换码时代），Java 侧在此录入 AccessKeySecret。
                 textPassword：这是长期凭据，不明文显示在屏幕上。 -->
            <EditText
                android:id="@+id/etCode"
                style="@style/Elder.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:hint="仅存本机，绝不上传"
                android:inputType="textPassword"
                android:singleLine="true"/>

            <!-- 凭据规则事前讲清；不塞进 hint——hint 是单行，系统字体放大后必被截断。 -->
            <TextView
                style="@style/Elder.Text.Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="Key 只存本机（Keystore 加密）；随时可在 DeepSeek 控制台吊销。"/>

            <!-- 复用 id=btnCancel（源自取消下单），Java 侧文案为「保存 API Key / 更换 API Key」 -->
            <Button
                android:id="@+id/btnCancel"
                style="@style/Elder.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap"
                android:text="保存 API Key"/>
        </LinearLayout>

        <!-- ② 单模型模式：资源包按模型名严格匹配，买之前就要讲清口径 -->
        <LinearLayout
            style="@style/Elder.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Switch
                android:id="@+id/swSingleModelBuy"
                style="@style/Elder.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:textSize="@dimen/elder_text_section"
                android:textStyle="bold"
                android:text="② 单模型模式"/>
            <TextView
                style="@style/Elder.Text.Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="省钱：所有请求只用一个模型。官方资源包按模型名严格匹配（qwen-plus 的包不抵扣 qwen-max），只有单模型时才能被同一个包抵扣。"/>
        </LinearLayout>

        <!-- ③ 官方页购买：App 内不代收、不预选档位 -->
        <LinearLayout
            style="@style/Elder.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="@style/Elder.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="③ 在官方页面购买"/>
            <TextView
                style="@style/Elder.Text.Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="App 不代收费用，也不会替你选档位——官方页面无法用链接预选套餐，请在那里自行确认价格与用量后支付。付款后返回本页，会自动创建并启用 API Key。"/>

            <!-- 档位卡片由 PurchaseActivity.renderPacks() 动态填充 -->
            <LinearLayout
                android:id="@+id/packsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap"
                android:orientation="vertical"/>

            <Button
                android:id="@+id/btnPay"
                style="@style/Elder.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/elder_touch_run"
                android:text="打开官方购买页"/>
        </LinearLayout>

        <!-- 当前状态：Key / 我方额度 / 上一步结果（tvMsg 由 Java 覆写） -->
        <LinearLayout
            style="@style/Elder.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="@style/Elder.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前状态"/>
            <TextView
                android:id="@+id/tvCurrentOrder"
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="尚未选择套餐"/>
            <TextView
                android:id="@+id/tvQuota"
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="额度：—"/>
            <TextView
                android:id="@+id/tvMsg"
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:accessibilityLiveRegion="polite"
                android:text=""/>
        </LinearLayout>

        <!-- 旧链路的订单记录：整块由 Java 隐藏 -->
        <LinearLayout
            android:id="@+id/orderArea"
            style="@style/Elder.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="@style/Elder.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="订单记录（旧链路，已废弃）"/>
            <TextView
                android:id="@+id/tvOrders"
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无订单"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
