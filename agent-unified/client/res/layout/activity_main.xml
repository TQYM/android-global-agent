<!--
  Agent Lite 主界面（手机 · 适老化版）

  面向老年人与不便使用手机的人，自上而下只有一条路：
    ① 看状态（准备好了 / 还差一步）→ ② 点「我要说话」或打字 → ③ 点「开始」→ ④ 看提示。
  不常用的「做过的事 / 授权 / 应用限制 / 记住的事」收在页面下方，账号在最底部。

  约束（改版前后一致）：
    · 全部控件 id 原样保留，MainActivity 的绑定与逻辑不变；
    · 截屏回显与日志仍按前一版需求隐藏（控件保留，供内部逻辑使用）；
    · 首屏文案不出现技术词（tests/spec_ux_001_guard.py UX-2）；
    · 控件只写 minHeight 不写死高度：系统字体调到最大时文字整行换行，不被裁切。
  手表形态不用本布局（见 activity_main_watch.xml，未改动）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elder_bg"
    android:fillViewport="true"
    android:clipToPadding="false">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="@dimen/elder_page_margin"
    android:paddingRight="@dimen/elder_page_margin"
    android:paddingBottom="@dimen/elder_gap">

    <!-- 顶栏：标题 + 设置 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/elder_gap_s"
        android:gravity="center_vertical">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">
            <TextView
                style="@style/Elder.Text.Title"
                android:text="Agent Lite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                style="@style/Elder.Text.Note"
                android:text="手机小帮手：说一句话，我帮您操作手机"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnConfig"
            style="@style/Elder.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginLeft="@dimen/elder_gap_s"
            android:drawableStart="@drawable/ic_elder_tune"
            android:text="设置"
            android:contentDescription="打开设置"/>
    </LinearLayout>

    <!-- 状态卡：一句话告诉老人「现在能不能用」 -->
    <LinearLayout
        style="@style/Elder.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tvStatus"
            style="@style/Elder.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="准备好了"
            android:accessibilityLiveRegion="polite"/>
        <TextView
            android:id="@+id/tvA11y"
            style="@style/Elder.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap_s"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_elder_neutral"
            android:paddingLeft="@dimen/elder_gap"
            android:paddingRight="@dimen/elder_gap"
            android:paddingTop="@dimen/elder_gap_s"
            android:paddingBottom="@dimen/elder_gap_s"
            android:text="正在检查手机权限…"/>
    </LinearLayout>

    <!-- ===================== 主视图 ===================== -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 还差一步：无障碍未开启时置顶显示 -->
        <LinearLayout
            android:id="@+id/a11yBanner"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap"
            android:background="@drawable/bg_elder_warn"
            android:padding="@dimen/elder_card_padding"
            android:visibility="gone">
            <TextView
                style="@style/Elder.Text.Section"
                android:textColor="@color/elder_warn_text"
                android:drawableStart="@drawable/ic_elder_warning"
                android:drawableTint="@color/elder_warn_text"
                android:drawablePadding="@dimen/elder_gap_s"
                android:gravity="center_vertical"
                android:text="还差一步"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                style="@style/Elder.Text"
                android:textColor="@color/elder_warn_text"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="需要在手机设置里打开「无障碍」开关，我才能看到屏幕、替您点按。点下面的按钮，找到「Agent Lite 无障碍服务」并打开即可。"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/btnA11yBanner"
                style="@style/Elder.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap"
                android:text="去打开开关"/>
        </LinearLayout>

        <!-- 第一步：说话（老人打字难，语音放在最显眼的位置） -->
        <Button
            android:id="@+id/btnMic"
            style="@style/Elder.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap"
            android:minHeight="@dimen/elder_touch_hero"
            android:textSize="@dimen/elder_text_hero"
            android:drawableStart="@drawable/ic_elder_mic"
            android:text="我要说话"
            android:contentDescription="我要说话。点一下开始说，说完再点一下"/>
        <TextView
            android:id="@+id/tvMicHint"
            style="@style/Elder.Text.Note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap_s"
            android:gravity="center_horizontal"
            android:text="点一下开始说，说完再点一下，我就开始做"/>

        <!-- 或者打字 -->
        <TextView
            style="@style/Elder.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="或者打字告诉我要做什么："/>
        <EditText
            android:id="@+id/etTask"
            style="@style/Elder.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：把声音调大一点"
            android:minLines="1"
            android:maxLines="4"
            android:inputType="textMultiLine"
            android:gravity="top|start"/>

        <!-- 试试这样说：点一下只填进输入框，不会直接执行 -->
        <TextView
            style="@style/Elder.Text.Note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap"
            android:text="不知道说什么？点一下下面的例子，会帮您填好："/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/btnEx1"
                style="@style/Elder.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="@dimen/elder_text_body"
                android:text="声音调大"/>
            <Button
                android:id="@+id/btnEx2"
                style="@style/Elder.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/elder_gap_s"
                android:textSize="@dimen/elder_text_body"
                android:text="屏幕调亮"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/btnEx3"
                style="@style/Elder.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="@dimen/elder_text_body"
                android:text="打开微信"/>
            <Button
                android:id="@+id/btnEx4"
                style="@style/Elder.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/elder_gap_s"
                android:textSize="@dimen/elder_text_body"
                android:text="帮我记住"/>
        </LinearLayout>

        <!-- 第二步：开始 / 停止 -->
        <Button
            android:id="@+id/btnRun"
            style="@style/Elder.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap"
            android:minHeight="@dimen/elder_touch_run"
            android:textSize="@dimen/elder_text_hero"
            android:drawableStart="@drawable/ic_elder_play"
            android:text="开始"/>

        <!-- 提示：把最近一条进度用大字说清楚（改版前只写进隐藏日志，老人看不到任何反馈） -->
        <TextView
            android:id="@+id/tvLastMsg"
            style="@style/Elder.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap"
            android:background="@drawable/bg_elder_neutral"
            android:padding="@dimen/elder_gap"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"/>

        <!-- 更多功能：一个功能一块，标题 + 一句话说明 -->
        <TextView
            style="@style/Elder.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap"
            android:text="更多功能"/>
        <Button
            android:id="@+id/btnHistory"
            style="@style/Elder.Button.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_elder_history"
            android:text="做过的事\n看看以前让我做过什么"/>
        <Button
            android:id="@+id/btnAuth"
            style="@style/Elder.Button.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_elder_lock"
            android:text="授权管理\n查看或收回允许我操作的应用"/>
        <Button
            android:id="@+id/btnEco"
            style="@style/Elder.Button.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_elder_shield"
            android:text="应用限制\n设置哪些应用不让我自动操作"/>
        <Button
            android:id="@+id/btnMemory"
            style="@style/Elder.Button.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_elder_star"
            android:text="记住的事\n查看或删除我记住的内容"/>

        <!-- 账号：未登录 / 失效时点这里直接进登录页；已登录点这里看额度 -->
        <TextView
            android:id="@+id/tvAccount"
            style="@style/Elder.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap"
            android:minHeight="@dimen/elder_touch"
            android:gravity="center_vertical"
            android:background="@drawable/btn_elder_tile"
            android:padding="@dimen/elder_gap"
            android:drawableStart="@drawable/ic_elder_person"
            android:drawableTint="@color/elder_primary"
            android:drawablePadding="@dimen/elder_gap"
            android:clickable="true"
            android:focusable="true"
            android:text="账号：检测中…"/>

        <!-- 已按要求移除呈现：截屏回显与日志（控件保留隐藏，供内部逻辑继续使用） -->
        <FrameLayout
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp">
            <FrameLayout
                android:id="@+id/flScreen"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_card">
                <ImageView
                    android:id="@+id/ivScreen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="实时屏幕回显"/>
                <View
                    android:id="@+id/vTap"
                    android:layout_width="26dp"
                    android:layout_height="@dimen/btn_h"
                    android:background="@drawable/tap_dot"
                    android:visibility="gone"/>
            </FrameLayout>
        </FrameLayout>
        <FrameLayout
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp">
            <ScrollView
                android:id="@+id/svLog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m">
                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_label"
                    android:textColor="@color/color_on_surface_variant"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.2"/>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
</ScrollView>
