<!--
  二级设置页（SettingsActivity · 手机适老化版）

  分两层，老人只需要看上半页：
    常用：① 我的账号（登录 / 额度 / 充值 / 兑换）  ② 让小帮手正常工作（无障碍 / 自启动 / 后台）
    高级设置（默认收起，「一般不用改，可以请家人帮忙」）：
          模型与接口配置 / 用量统计 / 屏幕适配 / 信息同步

  全部控件 id 与改版前一致，SettingsActivity 的 Prefs 读写逻辑原样保留；
  新增的只有收起/展开开关 btnAdvanced 与容器 advancedGroup。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elder_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settingsContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/elder_page_margin"
        android:paddingRight="@dimen/elder_page_margin"
        android:paddingTop="@dimen/elder_gap"
        android:paddingBottom="@dimen/elder_card_padding">

        <!-- 顶栏：返回放左边、做大，老人最常找的就是它 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnBack"
                style="@style/Elder.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:drawableStart="@drawable/ic_elder_back"
                android:text="返回"/>
            <TextView
                style="@style/Elder.Text.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/elder_gap"
                android:text="设置"/>
        </LinearLayout>

        <!-- ===== 一、我的账号 ===== -->
        <LinearLayout
            style="@style/Elder.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="@style/Elder.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="我的账号"/>
            <TextView
                android:id="@+id/tvAccount"
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="当前未登录"/>
            <TextView
                android:id="@+id/tvQuota"
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="额度：--"/>

            <Button
                android:id="@+id/btnAccountAction"
                style="@style/Elder.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap"
                android:drawableStart="@drawable/ic_elder_person"
                android:text="登录 / 换个账号"/>
            <Button
                android:id="@+id/btnBuy"
                style="@style/Elder.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="充值"/>
            <Button
                android:id="@+id/btnRefreshQuota"
                style="@style/Elder.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="刷新额度"/>

            <!-- 兑换码 -->
            <TextView
                style="@style/Elder.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="有兑换码？填在这里："/>
            <EditText
                android:id="@+id/etRedeem"
                style="@style/Elder.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="兑换码"
                android:singleLine="true"
                android:inputType="textVisiblePassword"/>
            <Button
                android:id="@+id/btnRedeem"
                style="@style/Elder.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="兑换"/>

            <!-- 同账号设备列表 -->
            <TextView
                style="@style/Elder.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="这个账号登录过的设备（可多台共用额度）"/>
            <TextView
                android:id="@+id/tvDevices"
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="登录后点「刷新额度」查看"/>

            <Button
                android:id="@+id/btnLogout"
                style="@style/Elder.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap"
                android:text="退出登录"/>
        </LinearLayout>

        <!-- ===== 二、让小帮手正常工作（原「保活与后台运行」） ===== -->
        <LinearLayout
            style="@style/Elder.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="@style/Elder.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="让小帮手正常工作"/>
            <TextView
                style="@style/Elder.Text.Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="如果小帮手经常「没反应」或者「自己关掉」，按顺序点下面三个按钮，在弹出的系统页面里打开对应开关。"/>
            <TextView
                android:id="@+id/tvKeepAlive"
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="自检中…"/>
            <Button
                android:id="@+id/btnA11y"
                style="@style/Elder.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap"
                android:text="① 打开无障碍开关"/>
            <Button
                android:id="@+id/btnAutoStart"
                style="@style/Elder.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="② 允许自动启动"/>
            <Button
                android:id="@+id/btnBatteryIgnore"
                style="@style/Elder.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="③ 允许后台运行（电池不限制）"/>
        </LinearLayout>

        <!-- ===== 高级设置开关 ===== -->
        <Button
            android:id="@+id/btnAdvanced"
            style="@style/Elder.Button.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap"
            android:drawableStart="@drawable/ic_elder_tune"
            android:text="高级设置（点开）\n一般不用改，可以请家人帮忙"/>

        <LinearLayout
            android:id="@+id/advancedGroup"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <!-- ===== 三、模型与 API 配置（原主页配置面板整体迁入） ===== -->
            <LinearLayout
                style="@style/Elder.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/Elder.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="模型与 API 配置"/>

                <TextView style="@style/Elder.Text.Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="服务地址（Base URL）"/>
                <EditText
                    android:id="@+id/etBase"
                    style="@style/Elder.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Base URL"
                    android:singleLine="true"
                    android:inputType="textUri"/>

                <TextView style="@style/Elder.Text.Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="密钥（API Key）"/>
                <EditText
                    android:id="@+id/etKey"
                    style="@style/Elder.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:hint="API Key"
                    android:singleLine="true"/>

                <TextView style="@style/Elder.Text.Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="主模型"/>
                <EditText
                    android:id="@+id/etModel"
                    style="@style/Elder.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="视觉主模型（默认 qwen3.5-omni-plus）"
                    android:singleLine="true"/>

                <Switch
                    android:id="@+id/swSingleModel"
                    style="@style/Elder.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/elder_gap"
                    android:text="单模型模式（省钱：所有请求只用一个模型）"/>
                <TextView
                    android:id="@+id/tvSingleModelHint"
                    style="@style/Elder.Text.Note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""/>

                <TextView style="@style/Elder.Text.Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="语音转文字"/>
                <EditText
                    android:id="@+id/etAsr"
                    style="@style/Elder.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="指定远端语音模型（如 glm-asr-2512；本地模式忽略）"
                    android:singleLine="true"/>
                <EditText
                    android:id="@+id/etAsrBase"
                    style="@style/Elder.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="云端语音端点（如 https://open.bigmodel.cn/api/paas/v4）"
                    android:singleLine="true"
                    android:inputType="textUri"/>
                <EditText
                    android:id="@+id/etAsrKey"
                    style="@style/Elder.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="独立语音密钥（留空不发鉴权，不使用主密钥）"
                    android:singleLine="true"
                    android:inputType="textPassword"/>
                <TextView
                    android:id="@+id/tvAsrHint"
                    style="@style/Elder.Text.Note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/elder_gap_s"
                    android:text="语音模式：端点留空仅本地离线；填写端点仅请求该服务一次，失败不切换。"/>
                <Button
                    android:id="@+id/btnAsrTest"
                    style="@style/Elder.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="测试语音转写链路"/>

                <TextView style="@style/Elder.Text.Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="语义规划模型"/>
                <EditText
                    android:id="@+id/etPlanner"
                    style="@style/Elder.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="语义规划模型（默认 qwen3.5-flash，留空=关闭规划）"
                    android:singleLine="true"/>

                <TextView style="@style/Elder.Text.Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="最多操作几步"/>
                <EditText
                    android:id="@+id/etMaxSteps"
                    style="@style/Elder.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="最大步数（默认 50）"
                    android:singleLine="true"
                    android:inputType="number"/>

                <Switch
                    android:id="@+id/swVision"
                    style="@style/Elder.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/elder_gap"
                    android:text="纯视觉模式（全流程截图感知）"/>

                <Button
                    android:id="@+id/btnSave"
                    style="@style/Elder.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/elder_gap"
                    android:text="保存配置"/>
            </LinearLayout>

            <!-- ===== 四、Token 统计 ===== -->
            <LinearLayout
                style="@style/Elder.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/Elder.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="累计消耗 Token"/>
                <TextView
                    android:id="@+id/tvTokens"
                    style="@style/Elder.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/elder_gap_s"
                    android:text="总计: 0 | 输入: 0 | 输出: 0"/>
                <Button
                    android:id="@+id/btnResetTokens"
                    style="@style/Elder.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="重置"/>
            </LinearLayout>

            <!-- ===== 五、设备形态（异形屏适配） ===== -->
            <LinearLayout
                style="@style/Elder.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/Elder.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="设备形态（挖孔/曲面/系统栏）"/>
                <TextView
                    android:id="@+id/tvDisplay"
                    style="@style/Elder.Text.Note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/elder_gap_s"
                    android:text="无障碍服务未连接，无法采集"/>
                <Button
                    android:id="@+id/btnDisplayCalib"
                    style="@style/Elder.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="坐标校准"/>
                <Button
                    android:id="@+id/btnDisplayRefresh"
                    style="@style/Elder.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="重新采集"/>
            </LinearLayout>

            <!-- ===== 六、信息同步 ===== -->
            <LinearLayout
                style="@style/Elder.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/Elder.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="信息同步（agentlite-server）"/>

                <!-- 守则 S-4：同步必须默认关闭且显式 opt-in -->
                <Switch
                    android:id="@+id/swSync"
                    style="@style/Elder.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/elder_gap"
                    android:text="允许上传本机历史与记忆"/>
                <TextView
                    android:id="@+id/tvSyncHint"
                    style="@style/Elder.Text.Note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="关闭后只存本机，不上传服务器"/>
                <TextView
                    android:id="@+id/tvSyncStatus"
                    style="@style/Elder.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/elder_gap_s"
                    android:text="尚未同步"/>
                <TextView style="@style/Elder.Text.Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="同步服务器地址"/>
                <EditText
                    android:id="@+id/etSyncServer"
                    style="@style/Elder.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="同步服务器地址"
                    android:singleLine="true"
                    android:inputType="textUri"/>
                <Button
                    android:id="@+id/btnSyncSave"
                    style="@style/Elder.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="保存地址"/>
                <Button
                    android:id="@+id/btnSyncNow"
                    style="@style/Elder.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="立即同步"/>
                <Button
                    android:id="@+id/btnLanRendezvous"
                    style="@style/Elder.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="局域网会合"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
