<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3（Material Design 3）深色基线色板
  · 命名沿用 M3 官方 token（primary / on-primary / primary-container / surface-container-* …）
  · API 31+ 由 res/values-v31/colors.xml 覆盖为系统动态色（Material You）
  · 旧色名全部保留（映射到 M3 语义），避免既有引用失效
-->
<resources>
    <!-- ===== Primary（主色）===== -->
    <color name="color_primary">#D0BCFF</color>
    <color name="color_on_primary">#381E72</color>
    <color name="color_primary_container">#4F378B</color>
    <color name="color_on_primary_container">#EADDFF</color>
    <color name="color_primary_hover">#B69DF8</color>

    <!-- ===== Secondary（次色）===== -->
    <color name="color_secondary">#CCC2DC</color>
    <color name="color_on_secondary">#332D41</color>
    <color name="color_secondary_container">#4A4458</color>
    <color name="color_on_secondary_container">#E8DEF8</color>

    <!-- ===== Tertiary（第三色）===== -->
    <color name="color_tertiary">#EFB8C8</color>
    <color name="color_on_tertiary">#492532</color>
    <color name="color_tertiary_container">#633B48</color>
    <color name="color_on_tertiary_container">#FFD8E4</color>

    <!-- ===== Error（错误）===== -->
    <color name="color_error">#F2B8B5</color>
    <color name="color_on_error">#601410</color>
    <color name="color_error_container">#8C1D18</color>
    <color name="color_on_error_container">#F9DEDC</color>
    <color name="color_error_text">#F2B8B5</color>

    <!-- ===== Surface（表面）与 M3 tonal surfaces ===== -->
    <color name="color_surface">#1C1B1F</color>
    <color name="color_on_surface">#E6E1E5</color>
    <color name="color_surface_variant">#49454F</color>
    <color name="color_on_surface_variant">#CAC4D0</color>
    <color name="color_surface_container_lowest">#0F0D13</color>
    <color name="color_surface_container_low">#1D1B20</color>
    <color name="color_surface_container">#211F26</color>
    <color name="color_surface_container_high">#2B2930</color>
    <color name="color_surface_container_highest">#36343B</color>
    <color name="color_inverse_surface">#E6E1E5</color>
    <color name="color_inverse_on_surface">#313033</color>

    <!-- ===== Outline（描边）===== -->
    <color name="color_outline">#938F99</color>
    <color name="color_outline_variant">#49454F</color>

    <!-- ===== 文本提示 ===== -->
    <color name="color_text_hint">#8E8A94</color>

    <!-- ===== 语义色（按 M3 色相调和）===== -->
    <color name="color_success">#7DD3A0</color>
    <color name="color_success_container">#1F4030</color>
    <color name="color_success_text">#A6E3BE</color>
    <color name="color_warning">#F5C77E</color>
    <color name="color_warning_container">#4A3717</color>
    <color name="color_warning_text">#FFDFA6</color>

    <!-- ===== 兼容旧名（映射到 M3 语义）===== -->
    <color name="color_accent_pink">#EFB8C8</color>
    <color name="color_accent_pink_light">#FFD8E4</color>
    <color name="color_island_bg">#F70F0D13</color>
    <color name="color_island_border">#33FFFFFF</color>
    <color name="color_island_expanded">#F2211F26</color>
</resources>
