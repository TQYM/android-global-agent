<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_primary_container"/>
            <stroke android:width="1dp" android:color="@color/color_primary"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_variant"/>
            <stroke android:width="1dp" android:color="@color/color_outline_variant"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
