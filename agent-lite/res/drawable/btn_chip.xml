<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 · Assist Chip（辅助标签）：surface-container-high + outline 描边 + 全圆角 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/color_primary">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_container_high"/>
            <stroke android:width="1dp" android:color="@color/color_outline_variant"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</ripple>
