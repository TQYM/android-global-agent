<!-- 嵌套卡片：外层已经是 bg_card（color_surface_container），内层必须抬高一档容器色，
     否则同色叠同色看不出边界——充值页的档位卡片位于「③ 在官方页面购买」卡片内部。
     对比度实测：卡片内 color_on_surface_variant(#94A3B8) 在 #232936 上为 5.68:1（AA 正文要求 4.5:1）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/color_surface_container_high"/>
    <stroke android:width="1dp" android:color="@color/color_outline"/>
    <corners android:radius="12dp"/>
</shape>
