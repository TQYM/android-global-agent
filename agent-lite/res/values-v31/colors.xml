<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ (API 31+) Material You 动态取色（Monet）
      覆盖 values/colors.xml 中的 M3 token → 应用跟随系统壁纸主色
    -->
    <!-- ===== Surface 系列（中性色）===== -->
    <color name="color_surface">@android:color/system_neutral1_900</color>
    <color name="color_on_surface">@android:color/system_neutral1_100</color>
    <color name="color_surface_variant">@android:color/system_neutral2_700</color>
    <color name="color_on_surface_variant">@android:color/system_neutral2_200</color>
    <color name="color_surface_container_lowest">@android:color/system_neutral1_1000</color>
    <color name="color_surface_container_low">@android:color/system_neutral1_900</color>
    <color name="color_surface_container">@android:color/system_neutral1_800</color>
    <color name="color_surface_container_high">@android:color/system_neutral1_700</color>
    <color name="color_surface_container_highest">@android:color/system_neutral1_600</color>

    <!-- ===== Outline ===== -->
    <color name="color_outline">@android:color/system_neutral2_500</color>
    <color name="color_outline_variant">@android:color/system_neutral2_700</color>

    <!-- ===== Primary（壁纸主色）===== -->
    <color name="color_primary">@android:color/system_accent1_200</color>
    <color name="color_primary_hover">@android:color/system_accent1_300</color>
    <color name="color_primary_container">@android:color/system_accent1_700</color>
    <color name="color_on_primary">@android:color/system_accent1_900</color>
    <color name="color_on_primary_container">@android:color/system_accent1_100</color>

    <!-- ===== Secondary（accent2）===== -->
    <color name="color_secondary">@android:color/system_accent2_200</color>
    <color name="color_on_secondary">@android:color/system_accent2_900</color>
    <color name="color_secondary_container">@android:color/system_accent2_700</color>
    <color name="color_on_secondary_container">@android:color/system_accent2_100</color>

    <!-- ===== Tertiary（accent3）===== -->
    <color name="color_tertiary">@android:color/system_accent3_200</color>
    <color name="color_on_tertiary">@android:color/system_accent3_900</color>
    <color name="color_tertiary_container">@android:color/system_accent3_700</color>
    <color name="color_on_tertiary_container">@android:color/system_accent3_100</color>

    <color name="color_text_hint">@android:color/system_neutral2_400</color>

    <!-- ===== 兼容旧名 ===== -->
    <color name="color_accent_pink">@android:color/system_accent3_200</color>
    <color name="color_accent_pink_light">@android:color/system_accent3_100</color>
    <color name="color_island_bg">#F70F0D13</color>
    <color name="color_island_border">#33FFFFFF</color>
    <color name="color_island_expanded">@android:color/system_neutral1_800</color>

    <!-- ===== 语义色（不随壁纸变，保持可读性）===== -->
    <color name="color_success">#7DD3A0</color>
    <color name="color_success_container">#1F4030</color>
    <color name="color_success_text">#A6E3BE</color>
    <color name="color_warning">#F5C77E</color>
    <color name="color_warning_container">#4A3717</color>
    <color name="color_warning_text">#FFDFA6</color>
    <color name="color_error">#F2B8B5</color>
    <color name="color_error_container">#8C1D18</color>
    <color name="color_error_text">#F2B8B5</color>
    <color name="color_on_error">#601410</color>
    <color name="color_on_error_container">#F9DEDC</color>
</resources>
