<!--
  系统召唤的语音助手抽屉（AssistActivity · 适老化版）
  召唤即开始听：最大的按钮就是「说完了」，其次「直接开始」，关闭放在右上角。
  全部 id 不变。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assistRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elder_scrim">

    <LinearLayout
        android:id="@+id/assistDialog"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/elder_gap"
        android:background="@drawable/bg_elder_card"
        android:padding="@dimen/elder_card_padding">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvAssistTitle"
                style="@style/Elder.Text.Section"
                android:text="语音小帮手"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/btnAssistClose"
                style="@style/Elder.Button.Secondary"
                android:layout_marginTop="0dp"
                android:text="关闭"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAssistHint"
            style="@style/Elder.Text"
            android:text="请说您要我做什么…"
            android:layout_marginTop="@dimen/elder_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"/>

        <Button
            android:id="@+id/btnAssistMic"
            style="@style/Elder.Button.Primary"
            android:text="我要说话"
            android:drawableStart="@drawable/ic_elder_mic"
            android:minHeight="@dimen/elder_touch_run"
            android:textSize="@dimen/elder_text_hero"
            android:layout_marginTop="@dimen/elder_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/etAssistInput"
            style="@style/Elder.Input"
            android:hint="或者打字告诉我"
            android:layout_marginTop="@dimen/elder_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"/>

        <Button
            android:id="@+id/btnAssistRun"
            style="@style/Elder.Button.Secondary"
            android:text="直接开始"
            android:drawableStart="@drawable/ic_elder_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
