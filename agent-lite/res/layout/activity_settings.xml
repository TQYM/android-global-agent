<!--
  二级设置页（SettingsActivity）
  主页只保留任务输入 / 运行 / 语音 / 状态 / 日志 / 截图 / 管理入口；
  API 配置（Base URL、API Key、模型、步数、纯视觉）连同 Token 统计、设备形态、
  保活入口、账号额度与兑换码一起收进本页。
  控件 id 与原 activity_main.xml 完全一致，Prefs 读写逻辑原样保留。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settingsContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- 顶栏 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">
                <TextView
                    android:text="设置"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_on_surface"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"/>
                <TextView
                    android:text="账号 / 模型 / 同步 / 保活"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="11sp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.TonalButton"
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="返回"
                android:textSize="13sp"
                android:textColor="@color/color_on_surface"
                                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <!-- ===== 一、账号与额度 ===== -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:text="账号与额度"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"/>

            <TextView
                android:id="@+id/tvAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textColor="@color/color_on_surface_variant"
                android:text="当前未登录"/>

            <TextView
                android:id="@+id/tvQuota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/color_on_surface"
                android:text="额度：-- units"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnRefreshQuota"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:text="刷新额度"
                    android:textSize="12sp"
                    android:textColor="@color/color_primary"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"/>
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnAccountAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:layout_marginLeft="6dp"
                    android:text="登录 / 切换账号"
                    android:textSize="12sp"
                    android:textColor="@color/color_primary"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"/>
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnLogout"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:layout_marginLeft="6dp"
                    android:text="退出登录"
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface_variant"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"/>
            </LinearLayout>

            <!-- 兑换码 -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/etRedeem"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:hint="兑换码"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:inputType="textVisiblePassword"
                    android:textColor="@color/color_on_surface"
                    android:textColorHint="@color/color_text_hint"
                    android:background="@drawable/bg_input"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"/>
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button"
                    android:id="@+id/btnRedeem"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginLeft="6dp"
                    android:text="兑换"
                    android:textSize="13sp"
                    android:textColor="@color/color_on_primary"
                                        android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>
            </LinearLayout>

            <!-- 同账号设备列表 -->
            <TextView
                android:text="本账号设备（同一账号可多台设备共用额度）"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"/>

            <TextView
                android:id="@+id/tvDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/color_on_surface_variant"
                android:text="登录后点击「刷新额度」查看"/>
        </LinearLayout>

        <!-- ===== 二、模型与 API 配置（原主页配置面板整体迁入） ===== -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:text="模型与 API 配置"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"/>

            <EditText
                android:id="@+id/etBase"
                android:hint="Base URL"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <EditText
                android:id="@+id/etKey"
                android:inputType="textPassword"
                android:hint="API Key"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <EditText
                android:id="@+id/etModel"
                android:hint="视觉主模型（默认 qwen3.5-omni-plus）"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <EditText
                android:id="@+id/etAsr"
                android:hint="语音模型（留空=主模型原生音频）"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <EditText
                android:id="@+id/etPlanner"
                android:hint="语义规划模型（默认 qwen3.5-flash，留空=关闭规划）"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <EditText
                android:id="@+id/etMaxSteps"
                android:hint="最大步数（默认 50）"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:inputType="number"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swVision"
                android:text="纯视觉模式（全流程截图感知）"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:textColor="@color/color_on_surface"/>

            <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button"
                android:id="@+id/btnSave"
                android:text="保存配置"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:textColor="@color/color_on_primary"
                                android:minHeight="0dp"/>
        </LinearLayout>

        <!-- ===== 三、Token 统计 ===== -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/bg_card">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:text="累计消耗 Token"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_surface"/>
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnResetTokens"
                    android:text="重置"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:textColor="@color/color_primary"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvTokens"
                android:text="总计: 0 | 输入: 0 | 输出: 0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/color_on_surface_variant"/>
        </LinearLayout>

        <!-- ===== 四、设备形态（异形屏适配） ===== -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/bg_card">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:text="设备形态（挖孔/曲面/系统栏）"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_surface"/>
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnDisplayCalib"
                    android:text="坐标校准"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginRight="6dp"
                    android:textColor="@color/color_primary"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"/>
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnDisplayRefresh"
                    android:text="重新采集"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:textColor="@color/color_primary"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvDisplay"
                android:text="无障碍服务未连接，无法采集"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="@color/color_on_surface_variant"/>
        </LinearLayout>

        <!-- ===== 五、保活与后台运行 ===== -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:text="保活与后台运行"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"/>

            <TextView
                android:id="@+id/tvKeepAlive"
                android:text="自检中…"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="@color/color_on_surface_variant"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnAutoStart"
                    android:text="自启动设置"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="32dp"
                    android:textSize="11sp"
                    android:textColor="@color/color_primary"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"/>
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnBatteryIgnore"
                    android:text="电池无限制"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="32dp"
                    android:layout_marginLeft="6dp"
                    android:textSize="11sp"
                    android:textColor="@color/color_primary"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"/>
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnA11y"
                    android:text="系统无障碍"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="32dp"
                    android:layout_marginLeft="6dp"
                    android:textSize="11sp"
                    android:textColor="@color/color_primary"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 六、信息同步 ===== -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:text="信息同步（agentlite-server）"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"/>

            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/color_on_surface_variant"
                android:text="尚未同步"/>

            <EditText
                android:id="@+id/etSyncServer"
                android:hint="同步服务器地址"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnSyncSave"
                    android:text="保存地址"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:textSize="12sp"
                    android:textColor="@color/color_primary"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"/>
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnSyncNow"
                    android:text="立即同步"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:layout_marginLeft="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/color_primary"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"/>
                <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/btnLanRendezvous"
                    android:text="局域网会合"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:layout_marginLeft="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/color_primary"
                                        android:minWidth="0dp"
                    android:minHeight="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
