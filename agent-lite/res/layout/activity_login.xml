<!--
  账号登录 / 注册页（LoginActivity · 手机适老化版）
  设计要点：
  - 输入框上方常驻标签（老人看不清框内的灰色提示字，也记不住提示消失前写的是什么）；
  - 密钥可点「显示」核对，输错了不必整串重打（新增 cbShowKey，只影响显示方式）；
  - 「登录」是唯一的实心主按钮；注册与「稍后再说」退为次按钮，避免点错；
  - 规则常驻展示，提交前就知道要求；
  - 全部 id 与手表版 activity_login_watch.xml 一致，LoginActivity 逻辑不变。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elder_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/loginContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/elder_page_margin"
        android:paddingRight="@dimen/elder_page_margin"
        android:paddingTop="@dimen/elder_gap"
        android:paddingBottom="@dimen/elder_card_padding">

        <!-- 顶栏 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnBack"
                style="@style/Elder.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:drawableStart="@drawable/ic_elder_back"
                android:text="返回"/>
            <TextView
                style="@style/Elder.Text.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/elder_gap"
                android:text="登录账号"/>
        </LinearLayout>
        <TextView
            style="@style/Elder.Text.Note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap_s"
            android:text="登录后，做过的事和记住的事会保存到您的账号里，换手机也不会丢。不登录也可以直接用。"/>

        <!-- 当前登录状态 -->
        <TextView
            android:id="@+id/tvCurrent"
            style="@style/Elder.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/elder_gap"
            android:background="@drawable/bg_elder_neutral"
            android:padding="@dimen/elder_gap"
            android:text="当前未登录"/>

        <!-- 输入卡片 -->
        <LinearLayout
            style="@style/Elder.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/Elder.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="账号名"/>
            <EditText
                android:id="@+id/etName"
                style="@style/Elder.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="小写字母或数字，例如 laowang"
                android:singleLine="true"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <TextView
                style="@style/Elder.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="账号密钥（相当于密码）"/>
            <EditText
                android:id="@+id/etKey"
                style="@style/Elder.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="至少 8 位"
                android:singleLine="true"
                android:inputType="textPassword"
                android:importantForAutofill="no"/>
            <CheckBox
                android:id="@+id/cbShowKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/elder_touch"
                android:textSize="@dimen/elder_text_body"
                android:textColor="@color/elder_text"
                android:buttonTint="@color/elder_primary"
                android:text="显示密钥，方便核对"/>

            <!-- 消息区（登录中 / 错误原因） -->
            <TextView
                android:id="@+id/tvMsg"
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnLogin"
                style="@style/Elder.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap"
                android:minHeight="@dimen/elder_touch_run"
                android:textSize="@dimen/elder_text_hero"
                android:text="登录"/>
            <Button
                android:id="@+id/btnRegister"
                style="@style/Elder.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="还没有账号？注册新账号"/>
            <Button
                android:id="@+id/btnSkip"
                style="@style/Elder.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="稍后再说"/>
        </LinearLayout>

        <!-- 规则说明：注册前就能看到账号名与密钥要求 -->
        <LinearLayout
            style="@style/Elder.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="@style/Elder.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="账号规则"/>
            <TextView
                android:id="@+id/tvRuleName"
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="· 账号名 3-32 位，仅小写字母、数字、下划线 _、连字符 -"/>
            <TextView
                android:id="@+id/tvRuleKey"
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="· 账号密钥至少 8 位（最多 256 位）"/>
            <TextView
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="· 新账号注册即赠送 500 额度（1 额度 = 1000 tokens）"/>
            <TextView
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="· 每次登录都会轮换账号令牌，其他设备上的旧令牌会立即失效"/>
            <TextView
                style="@style/Elder.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"
                android:text="· 密钥只在本机保存并用于换取令牌，服务端只存不可逆哈希"/>
            <TextView
                style="@style/Elder.Text.Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap"
                android:textStyle="bold"
                android:text="密钥丢了无法找回，请抄在本子上收好。"/>

            <TextView
                android:id="@+id/tvSyncTarget"
                style="@style/Elder.Text.Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/elder_gap_s"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
