<?xml version="1.0" encoding="utf-8"?>
<!--
  Agent Lite 主界面
  常驻：顶栏（设置/返回）+ 状态行
  主视图 mainContent：四大模块（放大）+ 任务下达
  二级设置页 llConfig：模型与接口 / 保活与后台 / 设备与显示 / 数据与调试
  截屏回显与日志已按要求移除呈现（控件保留隐藏，供内部逻辑使用）
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface"
    android:fillViewport="true">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <!-- 顶栏：标题 + 设置/返回 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">
            <TextView
                android:text="Agent Lite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_on_surface"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>
            <TextView
                android:text="原生智能体 · 灵动交互"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="11sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnConfig"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="设置"
            android:textSize="13sp"
            android:textColor="@color/color_on_surface"
            android:background="@drawable/btn_ghost"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:minWidth="0dp"
            android:minHeight="0dp"/>
    </LinearLayout>

    <!-- 状态行 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="空闲"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="12sp"
            android:background="@drawable/pill_gray"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
        <TextView
            android:id="@+id/tvA11y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textSize="12sp"
            android:text="无障碍"
            android:background="@drawable/pill_gray"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <!-- ===================== 主视图 ===================== -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/a11yBanner"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:visibility="gone">
            <TextView
                android:text="提示：需要开启无障碍服务，Agent 才能看屏与模拟操作"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/color_warning_text"
                android:textSize="13sp"/>
            <Button
                android:id="@+id/btnA11yBanner"
                android:text="一键开启"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:textSize="13sp"
                android:textColor="@color/color_on_primary"
                android:background="@drawable/btn_primary"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <!-- 四大模块（放大） -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <Button
                android:id="@+id/btnHistory"
                android:text="历史记录"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="96dp"
                android:textSize="15sp"
                android:textColor="@color/color_on_surface"
                android:background="@drawable/btn_ghost"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
            <Button
                android:id="@+id/btnAuth"
                android:text="授权管理"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="96dp"
                android:textSize="15sp"
                android:textColor="@color/color_on_surface"
                android:background="@drawable/btn_ghost"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <Button
                android:id="@+id/btnEco"
                android:text="省电策略"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="96dp"
                android:textSize="15sp"
                android:textColor="@color/color_on_surface"
                android:background="@drawable/btn_ghost"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
            <Button
                android:id="@+id/btnMemory"
                android:text="记忆库"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="96dp"
                android:textSize="15sp"
                android:textColor="@color/color_on_surface"
                android:background="@drawable/btn_ghost"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <!-- 任务下达 -->
        <EditText
            android:id="@+id/etTask"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="下达指令…"
            android:textSize="14sp"
            android:minLines="1"
            android:maxLines="3"
            android:textColor="@color/color_on_surface"
            android:textColorHint="@color/color_text_hint"
            android:background="@drawable/bg_input"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnMic"
                android:text="语音"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:textSize="13sp"
                android:textColor="@color/color_on_surface"
                android:background="@drawable/btn_ghost"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
            <Button
                android:id="@+id/btnRun"
                android:text="运行"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textColor="@color/color_on_primary"
                android:background="@drawable/btn_primary"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <!-- 已按要求移除呈现：截屏回显与日志（控件保留隐藏，供内部逻辑继续使用） -->
        <FrameLayout
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp">
            <FrameLayout
                android:id="@+id/flScreen"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card">
                <ImageView
                    android:id="@+id/ivScreen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="实时屏幕回显"/>
                <View
                    android:id="@+id/vTap"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/tap_dot"
                    android:visibility="gone"/>
            </FrameLayout>
        </FrameLayout>
        <FrameLayout
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp">
            <ScrollView
                android:id="@+id/svLog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card"
                android:padding="10dp">
                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/color_on_surface_variant"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.2"/>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- ===================== 二级设置页（分类） ===================== -->
    <ScrollView
        android:id="@+id/llConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="设置"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"/>
        <!-- 模型与接口 -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:text="模型与接口"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"/>

            <EditText
                android:id="@+id/etBase"
                android:hint="Base URL"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <EditText
                android:id="@+id/etKey"
                android:inputType="textPassword"
                android:hint="API Key"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <EditText
                android:id="@+id/etModel"
                android:hint="视觉主模型（默认 qwen3.5-omni-plus）"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <EditText
                android:id="@+id/etAsr"
                android:hint="语音模型（留空=主模型原生音频）"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <EditText
                android:id="@+id/etPlanner"
                android:hint="语义规划模型（默认 qwen3.5-flash，留空=关闭规划）"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <EditText
                android:id="@+id/etMaxSteps"
                android:hint="最大步数（默认 50）"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:inputType="number"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_hint"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"/>
            <Switch
                android:id="@+id/swVision"
                android:text="纯视觉模式（全流程截图感知）"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:textColor="@color/color_on_surface"/>
        </LinearLayout>
        <!-- 保活与后台 -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:text="保活与后台"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"/>

            <TextView
                android:id="@+id/tvKeepAlive"
                android:text="自检中…"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/color_on_surface_variant"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/btnAutoStart"
                    android:text="自启动设置"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface"
                    android:background="@drawable/btn_ghost"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>
                <Button
                    android:id="@+id/btnBatteryIgnore"
                    android:text="电池无限制"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:layout_marginLeft="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface"
                    android:background="@drawable/btn_ghost"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>
            </LinearLayout>
            <Button
                android:id="@+id/btnA11y"
                android:text="系统无障碍"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:textSize="13sp"
                android:layout_marginLeft="8dp"
                android:textColor="@color/color_on_surface"
                android:background="@drawable/btn_ghost"
                android:minHeight="0dp"/>
        </LinearLayout>
        <!-- 设备与显示 -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:text="设备与显示"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/btnDisplayCalib"
                    android:text="坐标校准"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface"
                    android:background="@drawable/btn_ghost"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>
                <Button
                    android:id="@+id/btnDisplayRefresh"
                    android:text="重新采集"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:layout_marginLeft="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface"
                    android:background="@drawable/btn_ghost"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvDisplay"
                android:text="无障碍服务未连接，无法采集"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="@color/color_on_surface_variant"/>
        </LinearLayout>
        <!-- 数据与调试 -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:text="数据与调试"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"/>

            <TextView
                android:id="@+id/tvTokens"
                android:text="总计: 0 | 输入: 0 | 输出: 0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/color_on_surface_variant"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/btnResetTokens"
                    android:text="Token 清零"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface"
                    android:background="@drawable/btn_ghost"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>
                <Button
                    android:id="@+id/btnSave"
                    android:text="保存配置"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:layout_marginLeft="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface"
                    android:background="@drawable/btn_ghost"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>
            </LinearLayout>
            <Button
                android:id="@+id/btnDebug"
                android:text="调试台"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:textSize="12sp"
                android:textColor="@color/color_primary"
                android:background="@drawable/btn_ghost"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
            <HorizontalScrollView
                android:id="@+id/dbgScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none"
                android:background="@drawable/bg_card"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/llDebug"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp">
                    <Button android:id="@+id/btnDbgNodes" android:text="感知" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                    <Button android:id="@+id/btnDbgShot" android:text="截图" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                    <Button android:id="@+id/btnDbgTap" android:text="点中心" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                    <Button android:id="@+id/btnDbgBack" android:text="返回" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                    <Button android:id="@+id/btnDbgEdge" android:text="手势返回" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                    <Button android:id="@+id/btnDbgHome" android:text="主页" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                    <Button android:id="@+id/btnDbgRecents" android:text="最近" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                    <Button android:id="@+id/btnDbgNotif" android:text="通知栏" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                    <Button android:id="@+id/btnDbgWifi" android:text="WiFi面板" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                    <Button android:id="@+id/btnDbgVol" android:text="音量+" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                    <Button android:id="@+id/btnDbgText" android:text="输中文" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                    <Button android:id="@+id/btnDbgIme" android:text="切换键盘" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:layout_height="36dp"/>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
</ScrollView>
