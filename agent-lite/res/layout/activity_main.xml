<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:padding="14dp">

    <!-- 顶栏：标题 + 状态 -->
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView android:text="Agent Lite"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#EAF0FA" android:textSize="18sp" android:textStyle="bold"/>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/tvStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="空闲" android:textColor="#8B93A3" android:textSize="12sp"
            android:background="@drawable/pill_gray"
            android:paddingLeft="10dp" android:paddingRight="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"/>
        <TextView android:id="@+id/tvA11y"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="8dp" android:textSize="12sp" android:text="无障碍"
            android:background="@drawable/pill_gray"
            android:paddingLeft="10dp" android:paddingRight="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"/>
        <Button android:id="@+id/btnConfig"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:layout_marginLeft="8dp" android:text="⚙ 设置" android:textSize="12sp"
            android:textColor="#C9D4E5" android:background="@drawable/btn_ghost"
            android:paddingLeft="12dp" android:paddingRight="12dp" android:minWidth="0dp"/>
    </LinearLayout>

    <!-- 无障碍引导横幅（未开启时显示） -->
    <LinearLayout android:id="@+id/a11yBanner"
        android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:background="@drawable/bg_card"
        android:padding="12dp" android:gravity="center_vertical"
        android:visibility="gone">
        <TextView android:text="⚠️ 需要先开启无障碍服务，Agent 才能看屏和操作"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#F0C36D" android:textSize="13sp"/>
        <Button android:id="@+id/btnA11yBanner" android:text="一键开启"
            android:layout_width="wrap_content" android:layout_height="38dp"
            android:textSize="13sp" android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary"
            android:paddingLeft="16dp" android:paddingRight="16dp"/>
    </LinearLayout>

    <!-- 配置面板（默认收起） -->
    <ScrollView android:id="@+id/llConfig"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:background="@drawable/bg_card"
        android:padding="12dp" android:layout_marginTop="10dp">
        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:id="@+id/etBase" android:hint="Base URL"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:textSize="13sp" android:singleLine="true"
                android:textColor="#EAF0FA" android:textColorHint="#5A6375"
                android:background="@drawable/bg_input" android:padding="10dp"/>
            <EditText android:id="@+id/etKey" android:inputType="textPassword" android:hint="API Key"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp" android:singleLine="true"
                android:textColor="#EAF0FA" android:textColorHint="#5A6375"
                android:background="@drawable/bg_input" android:padding="10dp"/>
            <EditText android:id="@+id/etModel" android:hint="模型（默认 qwen3.5-omni-plus）"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp" android:singleLine="true"
                android:textColor="#EAF0FA" android:textColorHint="#5A6375"
                android:background="@drawable/bg_input" android:padding="10dp"/>
            <EditText android:id="@+id/etAsr" android:hint="语音识别模型（留空=主模型原生音频）"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp" android:singleLine="true"
                android:textColor="#EAF0FA" android:textColorHint="#5A6375"
                android:background="@drawable/bg_input" android:padding="10dp"/>
            <EditText android:id="@+id/etMaxSteps" android:hint="最大步数（20）"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:textSize="13sp" android:singleLine="true" android:inputType="number"
                android:textColor="#EAF0FA" android:textColorHint="#5A6375"
                android:background="@drawable/bg_input" android:padding="10dp"/>
            <Switch android:id="@+id/swVision" android:text="视觉模式（截图发给模型）"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp" android:textColor="#C9D4E5"/>
            <LinearLayout android:orientation="horizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <Button android:id="@+id/btnSave" android:text="保存配置"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="42dp" android:textSize="13sp"
                    android:textColor="#FFFFFF" android:background="@drawable/btn_primary"/>
                <Button android:id="@+id/btnA11y" android:text="无障碍设置"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="42dp" android:textSize="13sp"
                    android:layout_marginLeft="8dp"
                    android:textColor="#C9D4E5" android:background="@drawable/btn_ghost"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 屏幕回显 + 点击标记 -->
    <FrameLayout android:id="@+id/flScreen"
        android:layout_width="match_parent" android:layout_height="210dp"
        android:layout_marginTop="10dp" android:background="@drawable/bg_screen">
        <ImageView android:id="@+id/ivScreen"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:contentDescription="屏幕"/>
        <View android:id="@+id/vTap"
            android:layout_width="26dp" android:layout_height="26dp"
            android:background="@drawable/tap_dot" android:visibility="gone"/>
    </FrameLayout>

    <!-- 日志标题行 + 调试开关 -->
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center_vertical">
        <TextView android:text="运行日志"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8B93A3" android:textSize="12sp"/>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <Button android:id="@+id/btnDebug" android:text="调试台"
            android:layout_width="wrap_content" android:layout_height="30dp"
            android:textSize="11sp" android:textColor="#7EA2FF"
            style="?android:attr/borderlessButtonStyle" android:minHeight="0dp"/>
    </LinearLayout>

    <!-- 日志 -->
    <ScrollView android:id="@+id/svLog"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="6dp"
        android:background="@drawable/bg_card" android:padding="10dp">
        <TextView android:id="@+id/tvLog"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#C9D4E5"
            android:fontFamily="monospace" android:lineSpacingMultiplier="1.15"/>
    </ScrollView>

    <!-- 调试台（默认收起；无 LLM 也可验证全动作链路） -->
    <HorizontalScrollView android:id="@+id/dbgScroll"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:scrollbars="none"
        android:background="@drawable/bg_card" android:visibility="gone">
        <LinearLayout android:id="@+id/llDebug" android:orientation="horizontal"
            android:layout_width="wrap_content" android:layout_height="wrap_content">
            <Button android:id="@+id/btnDbgNodes" android:text="感知" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
            <Button android:id="@+id/btnDbgShot" android:text="截图" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
            <Button android:id="@+id/btnDbgTap" android:text="点中心" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
            <Button android:id="@+id/btnDbgBack" android:text="返回" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
            <Button android:id="@+id/btnDbgEdge" android:text="手势返回" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
            <Button android:id="@+id/btnDbgHome" android:text="主页" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
            <Button android:id="@+id/btnDbgRecents" android:text="最近" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
            <Button android:id="@+id/btnDbgNotif" android:text="通知栏" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
            <Button android:id="@+id/btnDbgWifi" android:text="WiFi面板" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
            <Button android:id="@+id/btnDbgVol" android:text="音量+" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
            <Button android:id="@+id/btnDbgText" android:text="输中文" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
            <Button android:id="@+id/btnDbgIme" android:text="切换键盘" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="#7EA2FF" android:layout_width="wrap_content" android:layout_height="40dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 输入行 -->
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center_vertical">
        <EditText android:id="@+id/etTask"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:hint="说点什么，例如：打开WLAN设置"
            android:textSize="14sp" android:minLines="1" android:maxLines="3"
            android:textColor="#EAF0FA" android:textColorHint="#5A6375"
            android:background="@drawable/bg_input"
            android:paddingLeft="14dp" android:paddingRight="14dp"
            android:paddingTop="11dp" android:paddingBottom="11dp"/>
        <Button android:id="@+id/btnMic" android:text="🎤"
            android:layout_width="46dp" android:layout_height="46dp"
            android:layout_marginLeft="8dp" android:background="@drawable/btn_ghost"/>
        <Button android:id="@+id/btnRun" android:text="运行"
            android:layout_width="84dp" android:layout_height="46dp"
            android:layout_marginLeft="8dp" android:textSize="14sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:background="@drawable/btn_primary"/>
    </LinearLayout>
</LinearLayout>
