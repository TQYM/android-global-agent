<?xml version="1.0" encoding="utf-8"?>
<!--
  Agent Lite 主界面
  常驻：顶栏（设置）+ 状态行 + 账号状态行
  主视图 mainContent：四大模块（放大）+ 任务下达 + 调试台
  API 配置（Base URL / API Key / 模型 / 步数 / 纯视觉）连同 Token 统计、设备与显示、
  保活与后台、数据与调试设置项已全部搬到独立二级页面 SettingsActivity
  （res/layout/activity_settings.xml，控件 id 原样保留，Prefs 读写逻辑不变）。
  截屏回显与日志按前一版需求保留隐藏（控件保留，供内部逻辑使用）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface"
    android:fillViewport="true">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <!-- 顶栏：标题 + 设置 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">
            <TextView
                android:text="Agent Lite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_on_surface"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>
            <TextView
                android:text="原生智能体 · 灵动交互"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="11sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.TonalButton"
            android:id="@+id/btnConfig"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="设置"
            android:textSize="13sp"
            android:textColor="@color/color_on_surface"
                        android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:minWidth="0dp"
            android:minHeight="0dp"/>
    </LinearLayout>

    <!-- 状态行 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="空闲"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="12sp"
            android:background="@drawable/pill_gray"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
        <TextView
            android:id="@+id/tvA11y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textSize="12sp"
            android:text="无障碍"
            android:background="@drawable/pill_gray"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <!-- 账号状态行：未登录 / 令牌失效时点这里直接进登录页 -->
    <TextView
        android:id="@+id/tvAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/pill_gray"
        android:textColor="@color/color_on_surface_variant"
        android:text="账号：检测中…"/>

    <!-- ===================== 主视图 ===================== -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/a11yBanner"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:visibility="gone">
            <TextView
                android:text="提示：需要开启无障碍服务，Agent 才能看屏与模拟操作"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/color_warning_text"
                android:textSize="13sp"/>
            <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button"
                android:id="@+id/btnA11yBanner"
                android:text="一键开启"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:textSize="13sp"
                android:textColor="@color/color_on_primary"
                                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <!-- 四大模块（放大） -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.TonalButton"
                android:id="@+id/btnHistory"
                android:text="历史记录"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="96dp"
                android:textSize="15sp"
                android:textColor="@color/color_on_surface"
                                android:minWidth="0dp"
                android:minHeight="0dp"/>
            <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.TonalButton"
                android:id="@+id/btnAuth"
                android:text="授权管理"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="96dp"
                android:textSize="15sp"
                android:textColor="@color/color_on_surface"
                                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.TonalButton"
                android:id="@+id/btnEco"
                android:text="省电策略"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="96dp"
                android:textSize="15sp"
                android:textColor="@color/color_on_surface"
                                android:minWidth="0dp"
                android:minHeight="0dp"/>
            <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.TonalButton"
                android:id="@+id/btnMemory"
                android:text="记忆库"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="96dp"
                android:textSize="15sp"
                android:textColor="@color/color_on_surface"
                                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <!-- 第五个入口：二级设置页（模型/账号额度/同步/保活） -->
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.TonalButton"
            android:id="@+id/btnSettings"
            android:text="设置 · 账号 / 模型 / 同步"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:textSize="15sp"
            android:textColor="@color/color_on_surface"
                        android:minWidth="0dp"
            android:minHeight="0dp"/>

        <!-- 任务下达 -->
        <!-- 任务输入框：纵向容器里必须用 match_parent —— 原先误写 0dp+weight，
             在 vertical LinearLayout 中宽度会被算成 0，输入框实际不可见不可点。 -->
        <EditText
            android:id="@+id/etTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="下达指令…"
            android:textSize="14sp"
            android:minLines="1"
            android:maxLines="3"
            android:textColor="@color/color_on_surface"
            android:textColorHint="@color/color_text_hint"
            android:background="@drawable/bg_input"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.TonalButton"
                android:id="@+id/btnMic"
                android:text="语音"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:textSize="13sp"
                android:textColor="@color/color_on_surface"
                                android:minWidth="0dp"
                android:minHeight="0dp"/>
            <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button"
                android:id="@+id/btnRun"
                android:text="运行"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textColor="@color/color_on_primary"
                                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <!-- 调试台（动作直测，默认收起） -->
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.TonalButton"
            android:id="@+id/btnDebug"
            android:text="调试台"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="@color/color_primary"
                        android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"/>
        <HorizontalScrollView
            android:id="@+id/dbgScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none"
            android:background="@drawable/bg_card"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/llDebug"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgNodes" android:text="感知" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgShot" android:text="截图" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgTap" android:text="点中心" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgBack" android:text="返回" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgEdge" android:text="手势返回" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgHome" android:text="主页" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgRecents" android:text="最近" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgNotif" android:text="通知栏" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgWifi" android:text="WiFi面板" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgVol" android:text="音量+" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgText" android:text="输中文" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDbgIme" android:text="切换键盘" style="?android:attr/borderlessButtonStyle" android:textSize="12sp" android:textColor="@color/color_primary" android:layout_width="wrap_content" android:minHeight="0dp"
            android:layout_height="36dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 已按要求移除呈现：截屏回显与日志（控件保留隐藏，供内部逻辑继续使用） -->
        <FrameLayout
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp">
            <FrameLayout
                android:id="@+id/flScreen"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card">
                <ImageView
                    android:id="@+id/ivScreen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="实时屏幕回显"/>
                <View
                    android:id="@+id/vTap"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/tap_dot"
                    android:visibility="gone"/>
            </FrameLayout>
        </FrameLayout>
        <FrameLayout
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp">
            <ScrollView
                android:id="@+id/svLog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card"
                android:padding="10dp">
                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/color_on_surface_variant"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.2"/>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
</ScrollView>
