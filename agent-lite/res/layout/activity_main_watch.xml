<?xml version="1.0" encoding="utf-8"?>
<!--
  手表主页面（极简版）：状态行 + 语音大钮 + 打字输入 + 运行 + 设置入口。
   · 圆形表盘 / 方形表：边距由 values-round / values 两档 dimens 自适应
   · 主页不含日志、截图、历史、记忆、省电、授权——历史/记忆/省电/授权在设置页
     （WatchSettingsActivity），日志与截图手表端不提供
   · 手机端仍用 activity_main.xml，由 MainActivity.isWatchUi() 自动切换
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingLeft="@dimen/watch_edge"
        android:paddingRight="@dimen/watch_edge"
        android:paddingTop="@dimen/watch_pad_v"
        android:paddingBottom="@dimen/watch_pad_v">

        <!-- 顶行：状态（圆形屏顶部窄条只在中部宽度足够，状态文字居中） -->
        <TextView
            android:id="@+id/tvStatus"
            android:text="就绪"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- 无障碍未开启提示（点击直达系统开启页；开启后代码置 GONE） -->
        <TextView
            android:id="@+id/tvA11y"
            android:text="无障碍未开启"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:maxLines="1"/>

        <!-- 语音大钮 + 设置入口：置于圆最宽处，二者均完全落在圆内 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/watch_gap"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnMic"
                android:text="语音"
                android:layout_width="@dimen/watch_mic_size"
                android:layout_height="@dimen/watch_mic_size"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_watch_circle"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

            <Button
                android:id="@+id/btnWatchSettings"
                android:text="设置"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginLeft="10dp"
                android:textSize="11sp"
                android:textColor="@color/color_on_surface"
                android:background="@drawable/bg_watch_ghost"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <!-- 打字输入 -->
        <EditText
            android:id="@+id/etTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/watch_gap"
            android:hint="打字下达指令"
            android:textSize="13sp"
            android:minLines="1"
            android:maxLines="2"
            android:inputType="text"
            android:textColor="@color/color_on_surface"
            android:textColorHint="@color/color_text_hint"
            android:background="@drawable/bg_input"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <!-- 运行 / 停止 -->
        <Button
            android:id="@+id/btnRun"
            android:text="运行"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary"
            android:minWidth="0dp"
            android:minHeight="0dp"/>
    </LinearLayout>
</ScrollView>
